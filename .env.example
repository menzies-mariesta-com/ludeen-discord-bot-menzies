# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_menzies_server_id

# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# GitHub — classic PAT or fine-grained token with Issues read/write on target repos
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Map Discord channel IDs → GitHub repos (owner/name).
# Get a channel ID: Discord Developer Mode → right-click channel → Copy Channel ID
# Example:
# GITHUB_REPO_MAP={"111111111111111111":"your-org/frontend","222222222222222222":"your-org/backend"}
GITHUB_REPO_MAP={}

# Shared secret for GitHub → Ludeen webhooks (same value in every repo webhook)
GITHUB_WEBHOOK_SECRET=generate_a_long_random_string

# Max size per meeting recording upload part in MB (Discord free limit is 25; default 24)
MEETING_MAX_UPLOAD_MB=24

# Comma-separated lofi/focus radio stream URLs (rotates; avoids immediate repeat when 2+)
LOFI_STREAM_URLS=https://ice1.somafm.com/groovesalad-128-mp3,https://ice1.somafm.com/dronezone-128-mp3

# Optional local port (Railway sets PORT automatically)
# WEBHOOK_PORT=8080
